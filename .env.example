# ============================================================================
# HumanoBill — variáveis de ambiente
#
# Como usar:
#   cp .env.example .env      (o .env já está no .gitignore, nunca vai pro git)
#   preencha os valores marcados com  <<< PREENCHER
#   carregue com:  set -a && . ./.env && set +a
#
# Em produção, as mesmas variáveis vão no painel do Render (API) e da Vercel (web).
# ============================================================================


# ---------------------------------------------------------------------------
# 1. GEMINI (IA que lê a fatura)                                <<< PREENCHER
# Onde pegar: https://aistudio.google.com/apikey  ->  "Create API key"
# Quotas do free tier: https://aistudio.google.com/rate-limit
# Sem a chave, a API sobe normalmente, mas só as faturas de exemplo funcionam.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite


# ---------------------------------------------------------------------------
# 2. BANCO (Postgres)
#
# Local (Docker), já funciona sem mexer:
#   docker run -d --name hb-pg -e POSTGRES_PASSWORD=pg -e POSTGRES_DB=humanobill -p 55432:5432 postgres:17-alpine
#
# Produção (Supabase)                                           <<< PREENCHER no Render
# Onde pegar: https://supabase.com/dashboard -> projeto "humanobill" (região ca-central-1)
#   -> botão "Connect" -> aba "Session pooler" -> copie a URI (porta 5432)
#   e troque [YOUR-PASSWORD] pela senha definida ao criar o projeto.
#   Formato: postgresql://postgres.<ref>:<senha>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres
#   (não use a "Direct connection": ela é só IPv6 e o Render não alcança)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:pg@localhost:55432/humanobill


# ---------------------------------------------------------------------------
# 3. API (crates/api)
# CORS_ORIGIN: endereços do front autorizados a chamar a API (separados por vírgula).
#   Local: http://localhost:5173
#   Produção (no Render): a URL da Vercel, ex.: https://humanobill.vercel.app  <<< PREENCHER no Render
# ---------------------------------------------------------------------------
PORT=8099
RUST_LOG=info
CORS_ORIGIN=http://localhost:5173
FIXTURES_DIR=fixtures


# ---------------------------------------------------------------------------
# 4. FRONT (apps/web) — o Vite só lê variáveis que começam com VITE_
# Local: http://localhost:8099
# Produção (na Vercel): a URL do Render, ex.: https://humanobill-api.onrender.com  <<< PREENCHER na Vercel
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8099


# ---------------------------------------------------------------------------
# 5. KEEP-ALIVE (não vai no .env — é variável do repositório no GitHub)
# Depois do deploy no Render, rode uma vez:
#   gh variable set API_URL -b https://humanobill-api.onrender.com -R HeitorM50/humanobill
# E crie o monitor HTTP em https://uptimerobot.com apontando para <API_URL>/health (a cada 5 min).
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# 6. LEMBRETE POR E-MAIL (RF18/RF19). Opcional: sem estas variáveis a API sobe
#    normalmente e o lembrete responde "não está disponível agora".
# RESEND_API_KEY: https://resend.com/api-keys
# RESEND_FROM: remetente, ex.: HumanoBill <onboarding@resend.dev>. Sem domínio
#   verificado o Resend só entrega ao e-mail da própria conta (ponto em aberto P11).
# CRON_SECRET: texto aleatório longo, ex.: saída de `openssl rand -hex 32`.
#   O mesmo valor vai no Render e no segredo CRON_SECRET do GitHub (workflow lembretes.yml).
# WEB_URL: endereço do front, usado nos links dos e-mails. Vazio = primeira origem do CORS_ORIGIN.
# No GitHub, crie os segredos do repositório API_URL e CRON_SECRET:
#   gh secret set API_URL -b https://humanobill-api.onrender.com -R HeitorM50/humanobill
#   gh secret set CRON_SECRET -b "<mesmo valor>" -R HeitorM50/humanobill
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=
CRON_SECRET=
WEB_URL=


# ---------------------------------------------------------------------------
# 7. BOT NO WHATSAPP (#58). Opcional e DESLIGADO por padrão: sem as quatro primeiras
#    variáveis, GET e POST /whatsapp/webhook respondem 404. O simulador de conversa
#    (/whatsapp/simulador e a página /simulador-whatsapp) funciona sempre, sem estas variáveis.
# Onde pegar: https://developers.facebook.com/apps -> seu app -> WhatsApp (Cloud API).
# WHATSAPP_VERIFY_TOKEN: texto aleatório que você inventa (ex.: `openssl rand -hex 16`).
#   Digite o mesmo valor no campo "Verify token" ao cadastrar a URL do webhook.
# WHATSAPP_APP_SECRET: "Chave secreta do app" (Configurações do app -> Básico). Assina cada
#   chamada do webhook (X-Hub-Signature-256).
# WHATSAPP_TOKEN: token de acesso da Graph API (de preferência o permanente, de usuário do sistema).
# WHATSAPP_PHONE_ID: id do número de telefone (WhatsApp -> Configuração da API). Não é o número.
# WHATSAPP_GRAPH_URL: opcional. Padrão https://graph.facebook.com/v23.0 (troque para outra versão).
# URL do webhook a cadastrar na Meta: <URL da API>/whatsapp/webhook (campo "messages").
# Os links nas respostas usam WEB_URL (seção 6).
# ---------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_GRAPH_URL=
